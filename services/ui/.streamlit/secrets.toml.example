# Copy to secrets.toml (gitignored) and fill in real values.
# Google OAuth client comes from Google Cloud Console > APIs & Services >
# Credentials > OAuth 2.0 Client IDs (§3, §8 — "Google OAuth client secret").
# cookie_secret can be any random string (e.g. `openssl rand -hex 32`).

[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "replace-with-a-random-string"
client_id = "replace-with-your-google-oauth-client-id"
client_secret = "replace-with-your-google-oauth-client-secret"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
